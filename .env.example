# Supabase project settings — use the anon/public key only.
# Never put the service_role key in Vite or commit it to GitHub.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Final website domain, without a trailing slash.
# Example: https://irtiqamarketing.com
VITE_SITE_URL=https://YOUR-DOMAIN.com
